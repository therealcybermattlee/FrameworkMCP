{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framework-mcp-api",
  "main": "src/interfaces/worker/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated list of allowed CORS origins ("*" to allow any).
    "ALLOWED_ORIGINS": "*"
  },
  // Cloudflare's native rate-limiting binding: 100 requests / 60s per client IP.
  // Mirrors RATE_LIMIT_MAX / RATE_LIMIT_WINDOW_MS defaults from the Express server.
  "unsafe": {
    "bindings": [
      { "name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
    ]
  }
  // Custom domain (optional): uncomment and set your zone's hostname.
  // "routes": [{ "pattern": "api.example.com", "custom_domain": true }]
}
